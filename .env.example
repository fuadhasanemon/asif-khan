# Copy to .env.local (never commit real values).

# Vercel Analytics: set to "vercel" to enable. Off by default.
NEXT_PUBLIC_ANALYTICS=

# Hero renderer (optional Three.js renderer is not built yet; see PLAN.md).
NEXT_PUBLIC_HERO_RENDERER=tsparticles

# ── Admin panel (/admin) ──────────────────────────────────────────────
# Required to turn the admin on (8+ characters). Keep it secret.
ADMIN_PASSWORD=
# Optional: a separate random secret for signing sessions (defaults to one derived from the password).
ADMIN_SECRET=

# Production saving: each save becomes a commit in this GitHub repository,
# and Vercel redeploys the site. Use a fine-grained token limited to this
# repository with "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main

# Local saving outside `pnpm dev` (writes content/ on this machine's disk).
# ADMIN_LOCAL_WRITE=1
